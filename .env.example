# Salin ke .env lokal dan isi nilai rahasia sebelum menjalankan aplikasi.
FLASK_SECRET_KEY=

# Dibutuhkan hanya saat membuat akun admin pertama kali.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_EMAIL=admin@example.com

# Path ke file kredensial Google Earth Engine yang disimpan di luar repo.
GEE_PRIVATE_KEY_JSON=

# Isi jika hCaptcha diaktifkan.
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
HCAPTCHA_ENABLED=true
